<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:Top_DZ7_Avalonia.ViewModels"
		x:DataType="vm:MainWindowViewModel"
		x:Class="Top_DZ7_Avalonia.MainWindow"
		Width="900" Height="520"
		CanResize="False"
		Title="Менеджер сотрудников">
	<Grid RowDefinitions="Auto,*"
		  ColumnDefinitions="2*,3*"
		  Margin="16"
		  RowSpacing="12"
		  ColumnSpacing="12">
		<ListBox Grid.Row="1" Grid.Column="0"
				 ItemsSource="{Binding Employees}"
				 SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Spacing="2">
						<TextBlock Text="{Binding Name}" FontWeight="Bold"/>
						<TextBlock Text="{Binding Role}" FontSize="12" Opacity="0.75"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>
		<Border Grid.Row="1" Grid.Column="1"
				Padding="12"
				BorderThickness="1">
			<StackPanel Spacing="8">
				<TextBlock Text="Детали" FontWeight="Bold"/>

				<TextBlock Text="Имя"/>
				<TextBox Text="{Binding SelectedEmployee.Name, Mode=TwoWay}"/>

				<TextBlock Text="Должность"/>
				<TextBox Text="{Binding SelectedEmployee.Role, Mode=TwoWay}"/>

				<TextBlock Text="Возраст"/>
				<NumericUpDown Minimum="14" Maximum="99"
							   Value="{Binding SelectedEmployee.Age, Mode=TwoWay}"/>
			</StackPanel>
		</Border>
		<StackPanel Grid.Row="0" Grid.ColumnSpan="2"
					Orientation="Horizontal"
					Spacing="8">
			<Button Content="Добавить" Click="Add_Click"/>
			<Button Content="Сохранить в файл" Click="Save_Click"/>
			<Button Content="Загрузить из файла" Click="Load_Click"/>
		</StackPanel>

	</Grid>
</Window>
