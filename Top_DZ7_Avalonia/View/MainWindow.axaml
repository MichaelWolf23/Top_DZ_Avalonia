<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		xmlns:vm="using:Top_DZ7_Avalonia.ViewModels"
		x:DataType="vm:MainWindowViewModel"
		x:Class="Top_DZ7_Avalonia.MainWindow"
		Width="900" Height="520" CanResize="False"
		WindowStartupLocation="CenterScreen"
		Title="Менеджер сотрудников">
    
	<Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,3*" Margin="20" RowSpacing="16" ColumnSpacing="16">
        
		<Border Grid.Row="0" Grid.ColumnSpan="2" Classes="Card" Padding="12">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<Button Classes="Primary" Content="Добавить" Click="Add_Click"/>
				<Button Content="Редактировать" Click="Edit_Click" IsEnabled="{Binding SelectedEmployee, Converter={x:Static ObjectConverters.IsNotNull}}"/>
				<Button Classes="Danger" Content="Удалить" Click="Delete_Click" IsEnabled="{Binding SelectedEmployee, Converter={x:Static ObjectConverters.IsNotNull}}"/>
				<Separator Width="2" Height="30" Background="{DynamicResource BorderBrush}" Margin="4,0"/>
				<Button Content="Сохранить" Click="Save_Click"/>
				<Button Content="Загрузить" Click="Load_Click"/>
			</StackPanel>
		</Border>

		<Border Grid.Row="1" Grid.Column="0" Classes="Card" Padding="0">
			<ListBox ItemsSource="{Binding Employees}" 
					 SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" CornerRadius="12">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<StackPanel Spacing="4" Margin="8,4">
							<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource PrimaryTextBrush}"/>
							<TextBlock Text="{Binding Role}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/>
						</StackPanel>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Border>

		<Border Grid.Row="1" Grid.Column="1" Classes="Card">
			<StackPanel Spacing="12" IsVisible="{Binding SelectedEmployee, Converter={x:Static ObjectConverters.IsNotNull}}">
				<TextBlock Text="Детали сотрудника" Classes="Header"/>
				
                <Border Background="{DynamicResource PageBackgroundBrush}" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding SelectedEmployee.Name, StringFormat='Имя: {0}'}" FontSize="16" FontWeight="Medium"/>
				        <TextBlock Text="{Binding SelectedEmployee.Role, StringFormat='Должность: {0}'}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
				        <TextBlock Text="{Binding SelectedEmployee.Age, StringFormat='Возраст: {0} лет'}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
				        <TextBlock Text="{Binding SelectedEmployee.Email, StringFormat='Email: {0}'}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
			</StackPanel>
		</Border>
	</Grid>
</Window>