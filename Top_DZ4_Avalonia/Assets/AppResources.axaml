<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Thickness x:Key="SpacingM">15</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <x:Double x:Key="H1FontSize">26</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="CardBackground" Color="White"/>
            <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#6B7280"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5"/>
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#111827"/>
            <SolidColorBrush x:Key="CardBackground" Color="#1F2937"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F9FAFB"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#9CA3AF"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#818CF8"/>
        </ResourceDictionary>
        
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>