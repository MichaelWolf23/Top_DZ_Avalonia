<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="600"
		xmlns:vm="using:Top_DZ8_Avalonia.ViewModels"
		xmlns:conv="using:Top_DZ8_Avalonia.Converters"
		x:Class="Top_DZ8_Avalonia.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Title="Список покупок" Width="450" Height="600">

	<Window.Resources>
		<conv:BoughtToDecorationConverter x:Key="BoughtConverter"/>
	</Window.Resources>

	<DockPanel Margin="10">
		<StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
			<Separator/>
			<Grid ColumnDefinitions="*, Auto" Margin="10,0">
				<TextBlock Text="Общая сумма:" FontWeight="Bold"/>
				<TextBlock Grid.Column="1" Text="{Binding TotalSum, StringFormat='{}{0:N2} ₽'}" FontWeight="Bold" Foreground="Green"/>
			</Grid>
			<Button Content="Управление категориями" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnEditCategoriesClick"/>
		</StackPanel>

		<ScrollViewer>
			<ItemsControl ItemsSource="{Binding Categories}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Expander HorizontalAlignment="Stretch" Margin="0,2" IsExpanded="True">
							<Expander.Header>
								<Grid ColumnDefinitions="*, Auto">
									<TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
									<Button Grid.Column="1" Content="+"
											Click="OnAddItemClick"
											CommandParameter="{Binding}"
											Padding="10,0" Margin="5,0"/>
								</Grid>
							</Expander.Header>
							<ItemsControl ItemsSource="{Binding Items}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Grid ColumnDefinitions="Auto, *, Auto, Auto" Margin="5" ColumnSpacing="10">											
											<ToggleButton Grid.Column="0" IsChecked="{Binding IsImportant}"
														  Content="★" Padding="5,2"
														  Foreground="{Binding IsImportant, Converter={StaticResource BoughtConverter}, ConverterParameter='yellow'}"/>
											<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
													   TextDecorations="{Binding IsBought, Converter={StaticResource BoughtConverter}}"/>
											<TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='{}{0} ₽'}" VerticalAlignment="Center" TextAlignment="Right"/>
											<CheckBox Grid.Column="3" IsChecked="{Binding IsBought}" VerticalAlignment="Center"/>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Expander>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>
	</DockPanel>
</Window>